class Solution {
public:
    bool found = false;

    void find_target(int target, vector<int>& array, int start, int end)
    {
        if(start > end)
        {
            return;
        }

        int mid = (start + end) / 2;

        if(array[mid] == target)
        {
            found = true;
            return;
        }

        else if(array[mid] < target)
        {
            find_target(target, array, mid + 1, end);
        }

        else
        {
            find_target(target, array, start, mid - 1);
        }
    }

    bool search(vector<int>& nums, int target)
    {
        int n = nums.size();

        int max_index = n - 1;

        for(int i = 1; i < n; i++)
        {
            if(nums[i] < nums[i - 1])
            {
                max_index = i - 1;
                break;
            }
        }

        vector<int> array(n);

        int i = max_index + 1;
        int index = 0;

        while(i < n)
        {
            array[index] = nums[i];
            index++;
            i++;
        }

        for(int i = 0; i <= max_index; i++)
        {
            array[index] = nums[i];
            index++;
        }

        found = false;

        find_target(target, array, 0, n - 1);

        return found;
    }
};
