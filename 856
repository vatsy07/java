class Solution {
public:
    int sum = 0;

    int scoreOfParentheses(string s) {
        
        int n = s.size();

        int localSum[10000];
        int top = -1;

        for (int i = 0; i < n; i++)
        {
            // New '(' -> create a new local sum
            if (s[i] == '(')
            {
                top++;
                localSum[top] = 0;
            }
            else
            {
                // ')' -> complete current local sum
                int current = localSum[top];
                top--;

                // If nothing was inside -> ()
                if (current == 0)
                {
                    current = 1;
                }
                else
                {
                    // Something was inside -> double
                    current = current * 2;
                }

                // Give completed score to previous '('
                if (top >= 0)
                {
                    localSum[top] += current;
                }
                else
                {
                    // No previous '(' -> final answer
                    sum += current;
                }
            }
        }

        return sum;
    }
};
