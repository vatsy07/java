class Solution {
public:
    int candy(vector<int>& ratings) {
        vector<int>pref(ratings.size(),0);
        int curr=1;
        pref[0]=1;
        pref[ratings.size()-1]=1;
        for(int i=0;i<ratings.size();i++){
            if(i==ratings.size()-1){
                pref[i]=curr;
            }else if(ratings[i]<ratings[i+1]){
                pref[i]=curr;
                curr++;
            }else{
                pref[i]=curr;
                curr=1;
            }
        }
        int sum=0;
        
        curr=1;
        for(int i=ratings.size()-1;i>0;i--){
            sum+=max(curr, pref[i]);
            if(ratings[i]<ratings[i-1]){
                curr++;
            }else{
                curr=1;
            }
        }
        
        sum+=max(curr,pref[0]);
        return sum;
    }
};
