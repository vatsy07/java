class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int n = nums.size();

        // Find the sequential prefix sum
        int sum = nums[0];

        for (int i = 1; i < n; i++) {
            if (nums[i] == nums[i - 1] + 1) {
                sum += nums[i];
            } else {
                break;
            }
        }

        // Sort the array
        sort(nums.begin(), nums.end());

        // Find the smallest integer >= sum
        // that is NOT present in the array
        int target = sum;

        for (int x : nums) {
            if (x == target) {
                target++;
            }
        }

        return target;
    }
};
