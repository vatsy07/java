class Solution {
public:

    vector<vector<int>> board;
    vector<vector<int>> visit;
    vector<vector<string>> ans;

    void visited(int x, int y, int n)
    {
        for(int j = 0; j < n; j++)
            visit[x][j] = 1;

        for(int i = 0; i < n; i++)
            visit[i][y] = 1;

        int i = x;
        int j = y;

        while(i >= 0 && j >= 0)
        {
            visit[i][j] = 1;
            i--;
            j--;
        }

        i = x;
        j = y;

        while(i >= 0 && j < n)
        {
            visit[i][j] = 1;
            i--;
            j++;
        }

        i = x;
        j = y;

        while(i < n && j >= 0)
        {
            visit[i][j] = 1;
            i++;
            j--;
        }

        i = x;
        j = y;

        while(i < n && j < n)
        {
            visit[i][j] = 1;
            i++;
            j++;
        }
    }

    void unvisited(int n)
    {
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < n; j++)
                visit[i][j] = 0;
        }

        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < n; j++)
            {
                if(board[i][j] == 1)
                    visited(i, j, n);
            }
        }
    }

    void queens(int row, int n)
    {
        if(row == n)
        {
            vector<string> temp;

            for(int i = 0; i < n; i++)
            {
                string s = "";

                for(int j = 0; j < n; j++)
                {
                    if(board[i][j] == 1)
                        s += 'Q';
                    else
                        s += '.';
                }

                temp.push_back(s);
            }

            ans.push_back(temp);
            return;
        }

        for(int j = 0; j < n; j++)
        {
            if(visit[row][j] == 0)
            {
                board[row][j] = 1;

                visited(row, j, n);

                queens(row + 1, n);

                board[row][j] = 0;

                unvisited(n);
            }
        }
    }

    vector<vector<string>> solveNQueens(int n) {

        board.resize(n, vector<int>(n, 0));
        visit.resize(n, vector<int>(n, 0));

        queens(0, n);

        return ans;
    }
};
