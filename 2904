class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int n = s.size();
        int left = 0, right = 0, count = 0;
        string ans = "";

        while (right < n) {
            if (s[right] == '1')
                count++;

            while (count == k) {
                string current = s.substr(left, right - left + 1);

                if (ans.empty() || current.size() < ans.size() ||
                    (current.size() == ans.size() && current < ans)) {
                    ans = current;
                }

                if (s[left] == '1')
                    count--;

                left++;
            }

            right++;
        }

        return ans;
    }
};
