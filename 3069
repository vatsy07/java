class Solution {
public:
    vector<int> resultArray(vector<int>& nums) {

        int n = nums.size();

        vector<int> first(n);
        vector<int> last(n);

        int first_ind = 0;
        int last_ind = 0;

        first[first_ind++] = nums[0];
        last[last_ind++] = nums[1];

        for (int i = 2; i < n; i++)
        {
            if (first[first_ind - 1] > last[last_ind - 1])
            {
                first[first_ind++] = nums[i];
            }
            else
            {
                last[last_ind++] = nums[i];
            }
        }

        vector<int> result;

        for (int i = 0; i < first_ind; i++)
        {
            result.push_back(first[i]);
        }

        for (int i = 0; i < last_ind; i++)
        {
            result.push_back(last[i]);
        }

        return result;
    }
};
