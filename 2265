/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */

class Solution {
public:

    int ans = 0;

    int* traverse(TreeNode* head)
    {
        TreeNode* root = head;

        int sum = head->val;
        int count = 1;

        TreeNode* LEFT = head->left;
        TreeNode* RIGHT = head->right;

        // Leaf node
        if (LEFT == NULL && RIGHT == NULL)
        {
            int* ret_value = new int[2];

            ret_value[0] = sum;
            ret_value[1] = count;

            int avg = sum / count;

            if (avg == root->val)
            {
                ans++;
            }

            return ret_value;
        }

        int* left_traversal = new int[2]{0, 0};
        int* right_traversal = new int[2]{0, 0};

        if (LEFT != NULL)
        {
            left_traversal = traverse(LEFT);
        }

        if (RIGHT != NULL)
        {
            right_traversal = traverse(RIGHT);
        }

        sum = sum + left_traversal[0] + right_traversal[0];

        count = count + left_traversal[1] + right_traversal[1];

        int* ret_value = new int[2];

        ret_value[0] = sum;
        ret_value[1] = count;

        int avg = sum / count;

        if (avg == root->val)
        {
            ans++;
        }

        return ret_value;
    }

    int averageOfSubtree(TreeNode* root)
    {
        traverse(root);

        return ans;
    }
};
