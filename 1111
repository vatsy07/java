class Solution {
public:
    vector<int> maxDepthAfterSplit(string seq) {

        vector<int> ans;

        int depth0 = 0;
        int depth1 = 0;

        bool open0 = false;
        bool open1 = false;

        for (int i = 0; i < seq.size(); i++) {

            if (seq[i] == '(') {

                // Put '(' in the group with smaller depth
                if (depth0 <= depth1) {
                    ans.push_back(0);
                    depth0++;
                    open0 = true;
                }
                else {
                    ans.push_back(1);
                    depth1++;
                    open1 = true;
                }
            }

            else { // ')'

                // Put ')' in the group with greater depth
                if (depth0 >= depth1) {
                    ans.push_back(0);
                    depth0--;

                    if (depth0 == 0)
                        open0 = false;
                }
                else {
                    ans.push_back(1);
                    depth1--;

                    if (depth1 == 0)
                        open1 = false;
                }
            }
        }

        return ans;
    }
};
