class Solution {
public:
    long long countCommas(long long n) {

        if(n <= 999)
        {
            return 0;
        }

        long long num = n;
        long long i = 1000;
        long long count = 0;

        while(i <= num)
        {
            if(i <= 999999)
            {
                if(num > 999999)
                {
                    long long diff = 999999 - i;
                    count = count + (diff + 1) * 1;
                    i = 1000000;
                }
                else
                {
                    long long diff = num - i;
                    count = count + (diff + 1) * 1;
                    break;
                }
            }

            else if(i <= 999999999)
            {
                if(num > 999999999)
                {
                    long long diff = 999999999 - i;
                    count = count + (diff + 1) * 2;
                    i = 1000000000;
                }
                else
                {
                    long long diff = num - i;
                    count = count + (diff + 1) * 2;
                    break;
                }
            }

            else if(i <= 999999999999)
            {
                if(num > 999999999999)
                {
                    long long diff = 999999999999 - i;
                    count = count + (diff + 1) * 3;
                    i = 1000000000000;
                }
                else
                {
                    long long diff = num - i;
                    count = count + (diff + 1) * 3;
                    break;
                }
            }

            else if(i <= 999999999999999)
            {
                if(num > 999999999999999)
                {
                    long long diff = 999999999999999 - i;
                    count = count + (diff + 1) * 4;
                    i = 1000000000000000;
                }
                else
                {
                    long long diff = num - i;
                    count = count + (diff + 1) * 4;
                    break;
                }
            }

            else if(i <= 999999999999999999)
            {
                if(num > 999999999999999999)
                {
                    long long diff = 999999999999999999 - i;
                    count = count + (diff + 1) * 5;
                    i = 1000000000000000000LL;
                }
                else
                {
                    long long diff = num - i;
                    count = count + (diff + 1) * 5;
                    break;
                }
            }

            else
            {
                long long diff = num - i;
                count = count + (diff + 1) * 6;
                break;
            }
        }

        return count;
    }
};
