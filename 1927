class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();

        int leftSum = 0;
        int rightSum = 0;
        int leftQ = 0;
        int rightQ = 0;

        // Calculate sums and count '?'
        for (int i = 0; i < n / 2; i++) {
            if (num[i] == '?')
                leftQ++;
            else
                leftSum += num[i] - '0';
        }

        for (int i = n / 2; i < n; i++) {
            if (num[i] == '?')
                rightQ++;
            else
                rightSum += num[i] - '0';
        }

        bool aliceTurn = true;

        while (leftQ > 0 || rightQ > 0) {

            // ================= ALICE =================
            if (aliceTurn) {

                // LEFT is greater or equal
                if (leftSum >= rightSum) {

                    // Alice can increase the larger side
                    if (leftQ > 0) {
                        leftSum += 9;
                        leftQ--;
                    }
                    // No '?' on larger side, so play on smaller side
                    else {
                        int diff = leftSum - rightSum;

                        if (diff < 9)
                            rightSum += diff + 1;
                        else
                            rightSum += 0;

                        rightQ--;
                    }
                }

                // RIGHT is greater
                else {

                    // Alice can increase the larger side
                    if (rightQ > 0) {
                        rightSum += 9;
                        rightQ--;
                    }
                    // No '?' on larger side, so play on smaller side
                    else {
                        int diff = rightSum - leftSum;

                        if (diff < 9)
                            leftSum += diff + 1;
                        else
                            leftSum += 0;

                        leftQ--;
                    }
                }
            }

            // ================= BOB =================
            else {
                int diff = abs(leftSum - rightSum);

                // LEFT is smaller
                if (leftSum < rightSum) {

                    if (leftQ > 0) {
                        int add = min(diff, 9);
                        leftSum += add;
                        leftQ--;
                    }
                    else {
                        // Bob has no '?' on smaller side
                        rightSum += 0;
                        rightQ--;
                    }
                }

                // RIGHT is smaller or both are equal
                else {

                    if (rightQ > 0) {
                        int add = min(diff, 9);
                        rightSum += add;
                        rightQ--;
                    }
                    else {
                        // Bob has no '?' on smaller side
                        leftSum += 0;
                        leftQ--;
                    }
                }
            }

            // Switch turns
            aliceTurn = !aliceTurn;
        }

        return leftSum != rightSum;
    }
};
