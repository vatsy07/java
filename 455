class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        sort(g.begin(), g.end());
        sort(s.begin(), s.end());

        int n1 = g.size();
        int n2 = s.size();

        int cookie_used = -1;
        int count = 0;

        for (int i = 0; i < n1; i++) {
            bool cookie_found = false;

            if (cookie_used >= n2 - 1) {
                break;
            }

            for (int j = cookie_used + 1; j < n2; j++) {
                if (g[i] <= s[j]) {
                    cookie_used = j;
                    cookie_found = true;
                    count++;
                    break;
                }
            }

            if (!cookie_found) {
                break;
            }
        }

        return count;
    }
};
